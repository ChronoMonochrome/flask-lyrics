# Stage 1: Build Frontend
# Use a Node.js image to build the frontend assets
FROM node:16-alpine as build-env

# Install git (if needed for your frontend build, otherwise remove)
RUN apk add --no-cache git

# Create a temporary directory for the entire project source and set it as working directory.
WORKDIR /usr/src/app/repo_source

# Copy package.json and package-lock.json first for better caching
COPY ./front/package*.json ./

# Install frontend dependencies
RUN npm install --force

# Copy the rest of the frontend source code
COPY ./front/ .

# Build the project. This command creates a 'build' folder by default for create-react-app
RUN npm run build


# Stage 2: Build Flask Application
# Use a Python runtime as the base for the final application image
FROM python:3.9-slim-buster

# Set the working directory in the container
WORKDIR /app

# Install system dependencies required for building some Python packages (e.g., gevent)
# and for MySQL client libraries
RUN apt-get update && apt-get install -y \
    build-essential \
    default-libmysqlclient-dev \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Create the /app/app/static directory BEFORE copying into it
RUN mkdir -p /dist
RUN mkdir -p /usr/src/app/repo_source/dist
RUN mkdir -p /usr/src/app/repo_source/build
RUN mkdir -p /app/app/static
RUN mkdir -p /app/data # Ensure data directory exists

# Copy local requirements.txt and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the data files (words.ljson, words.idx, lyrics.json) into the container
# This is crucial for the app to find the word and lyrics data.
COPY ./data /app/app/static/data

# Copy the built frontend assets from the frontend_builder stage.
# The 'build' folder is now expected to be located inside /usr/src/app/repo_source/build.
COPY --from=build-env /usr/src/app/repo_source/build /app/app/static

# Set permissions for the static folder recursively
RUN chmod -R 775 /app/app/static

# Copy the rest of the Flask application code (app/ directory, logger.py)
# Make sure your local 'app' directory and 'logger.py' are in the root of your project context
COPY app /app/app

# Run the script to generate the HTML cache and song list file
# This step happens during the image build process, AFTER the app code is copied
RUN mkdir -p app/static/cache && python -m app.generate_cache

# NOTE: The cache is now generated on the host and mounted via a volume.
# REMOVE the following line from your Dockerfile:
# RUN mkdir -p app/static/cache && python -m app.generate_cache

# Expose port 8012, where Gunicorn will listen
EXPOSE 8012

# Command to run Gunicorn.
# 'app:create_app()' tells gunicorn to call the create_app() function
# inside the app module to get the Flask application instance.
CMD ["gunicorn", "-w", "4", "-b", "0.0.0.0:8012", "--access-logfile", "-", "--error-logfile", "-", "app:create_app()"]
