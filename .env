# Database Configuration
MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=japanese_riddles_db
MYSQL_USER=japanese_user
MYSQL_PASSWORD=japanese_password
DATABASE_URL=mysql+pymysql://japanese_user:japanese_password@db:3306/japanese_riddles_db

# Flask Configuration
SECRET_KEY=super_secret_flask_key_change_me_in_production
DEBUG=True # Set to False in production
SESSION_PERMANENT=True
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME_SECONDS=36000 # 10 hours
SESSION_FILE_THRESHOLD=1000000

# Logging
LOG_ROTATE_DAYS=30
